{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/inkwell-app/fdx-inspect/blob/main/schemas/batch.schema.json",
  "title": "FDX CLI batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "results"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "report"],
            "properties": {
              "input": {
                "type": "string"
              },
              "report": {
                "$ref": "https://github.com/inkwell-app/fdx-inspect/blob/main/schemas/report.schema.json"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "error"],
            "properties": {
              "input": {
                "type": "string"
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message"],
                "properties": {
                  "code": {
                    "enum": [
                      "file_not_found",
                      "permission_denied",
                      "not_regular_file",
                      "input_too_large",
                      "invalid_encoding",
                      "read_failed"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
